# Server-side Gemini API key (never expose to frontend)
GEMINI_API_KEY=

# Gemini model to use via Google GenAI Interactions API
GEMINI_MODEL=gemini-4-hydrogen

# Security / Auth
JWT_SECRET=change-me-in-production-to-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Storage & Privacy
MAX_UPLOAD_MB=15
DEFAULT_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
